# Zai Cockpit local API server
ZAI_COCKPIT_API_PORT=8787
ZAI_COCKPIT_HANDOFF_DIR=zai-handoff

# Z.ai account (required for autorun)
# Create a key at https://z.ai/model-api or from your GLM Coding Plan page.
ZAI_API_KEY=

# Endpoint selection: auto (default) uses the GLM Coding Plan endpoint first
# and falls back to the pay-as-you-go endpoint when no coding plan is active.
# Use "coding" or "api" to pin one endpoint.
ZAI_ENDPOINT_MODE=auto
ZAI_CODING_BASE_URL=https://api.z.ai/api/coding/paas/v4
ZAI_API_BASE_URL=https://api.z.ai/api/paas/v4

# Models: chat drives the agent loop; glm-image renders images.
ZAI_CHAT_MODEL=glm-4.7
ZAI_IMAGE_MODEL=glm-image

# Optional: pin the image generation endpoint. By default images follow
# ZAI_API_BASE_URL (coding plan first) and auto-fall back to
# https://api.z.ai/api/paas/v4 when the coding base cannot serve them.
# ZAI_IMAGE_API_BASE_URL=https://api.z.ai/api/paas/v4

# Runner behavior
ZAI_COCKPIT_RUNNER_AUTORUN=1
ZAI_COCKPIT_RUNNER_COMMAND=
ZAI_COCKPIT_RUNNER_HELP_ARGS_JSON=
ZAI_COCKPIT_RUNNER_EXEC_ARGS_JSON=
ZAI_COCKPIT_ALLOW_MOCK_RUNNER=0
